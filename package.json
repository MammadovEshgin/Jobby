{
  "name": "jobby",
  "version": "0.1.0",
  "description": "Jobby - Telegram bot that aggregates Azerbaijani job vacancies hourly and notifies users about the positions they follow.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm test && npm run audit:deps",
    "check:fast": "npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 7",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "db:apply:local": "wrangler d1 execute vakansiya-bot --local --file=schema.sql",
    "db:apply:remote": "wrangler d1 execute vakansiya-bot --remote --file=schema.sql"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "node-html-parser": "^6.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.60.0"
  },
  "engines": {
    "node": ">=20"
  }
}
